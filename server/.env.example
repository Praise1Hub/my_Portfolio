PORT=5000
CLIENT_URL=http://localhost:5173

# Email notifications (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=yourname@gmail.com
# Gmail App Password (16 characters), NOT your normal password.
# Create one at: Google Account > Security > 2-Step Verification > App passwords
EMAIL_PASS=your-app-password
# Where messages are delivered (defaults to EMAIL_USER if left out)
EMAIL_TO=yourname@gmail.com
